{
  "name": "frameevidence",
  "version": "0.1.1",
  "description": "Bounded, read-only design evidence for agent harnesses; compatible with DeepSeek Harness and the Figma REST API.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
